{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccount": {
      "type": "string",
      "description": "The service account to use for the agent",
      "default": "default"
    },
    "image": {
      "type": "object",
      "description": "Docker image configuration",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Docker image repository",
          "default": "coordimap/coordimap-agent"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag",
          "default": "latest"
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy",
          "default": "Always",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "description": "Resource requests and limits",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "memory": { "type": "string" },
            "cpu": { "type": "string" },
            "ephemeral-storage": { "type": "string" }
          },
          "required": ["memory", "cpu", "ephemeral-storage"],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "memory": { "type": "string" },
            "cpu": { "type": "string" },
            "ephemeral-storage": { "type": "string" }
          },
          "required": ["memory", "cpu", "ephemeral-storage"],
          "additionalProperties": false
        }
      },
      "required": ["requests", "limits"],
      "additionalProperties": false
    },
    "apiKey": {
      "type": "string",
      "description": "Coordimap API key for authentication"
    },
    "endpoint": {
      "type": "string",
      "description": "Coordimap API endpoint",
      "default": "https://api.coordimap.com/collector/crawlers/infra"
    },
    "debug": {
      "type": "boolean",
      "description": "Enable debug logging",
      "default": true
    },
    "dataSources": {
      "type": "array",
      "description": "Coordimap Agent data sources rendered directly into coordimap.data_sources",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Data source type"
          },
          "name": {
            "type": "string",
            "description": "Data source name"
          },
          "desc": {
            "type": "string",
            "description": "Optional description for the data source"
          },
          "config": {
            "type": "array",
            "description": "List of name/value config entries passed through to the agent",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Config key name"
                },
                "value": {
                  "type": ["string", "number", "boolean"],
                  "description": "Config value"
                }
              },
              "required": ["name", "value"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "name", "config"],
        "additionalProperties": false
      }
    }
  },
  "required": ["image", "resources", "apiKey", "endpoint", "dataSources"],
  "additionalProperties": false
}
