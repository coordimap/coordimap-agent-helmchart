{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccount": {
      "description": "Service account configuration for the agent",
      "default": {
        "create": true,
        "name": "",
        "annotations": {}
      },
      "oneOf": [
        {
          "type": "string",
          "description": "Legacy service account name. If set, the chart uses an existing account."
        },
        {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean",
              "description": "Whether the chart should create the service account",
              "default": true
            },
            "name": {
              "type": "string",
              "description": "Service account name. Defaults to <release-name>-agent when empty.",
              "default": ""
            },
            "annotations": {
              "type": "object",
              "description": "Annotations applied when the chart creates the service account",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "commonLabels": {
      "type": "object",
      "description": "Extra labels applied to all rendered resources and pods",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "image": {
      "type": "object",
      "description": "Docker image configuration",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Docker image repository",
          "default": "coordimap/coordimap-agent"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag",
          "default": "latest"
        },
        "pullPolicy": {
          "type": "string",
          "description": "Image pull policy",
          "default": "Always",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "description": "Resource requests and limits",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "memory": { "type": "string" },
            "cpu": { "type": "string" },
            "ephemeral-storage": { "type": "string" }
          },
          "required": ["memory", "cpu", "ephemeral-storage"],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "memory": { "type": "string" },
            "cpu": { "type": "string" },
            "ephemeral-storage": { "type": "string" }
          },
          "required": ["memory", "cpu", "ephemeral-storage"],
          "additionalProperties": false
        }
      },
      "required": ["requests", "limits"],
      "additionalProperties": false
    },
    "apiKey": {
      "type": "string",
      "description": "Coordimap API key for authentication"
    },
    "endpoint": {
      "type": "string",
      "description": "Coordimap API endpoint",
      "default": "https://api.coordimap.com/collector/crawlers/infra"
    },
    "debug": {
      "type": "boolean",
      "description": "Enable debug logging",
      "default": true
    },
    "extraEnv": {
      "type": "array",
      "description": "Extra environment variables for the agent container",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Environment variable name"
          },
          "value": {
            "type": ["string", "number", "boolean"],
            "description": "Literal environment variable value"
          },
          "valueFrom": {
            "type": "object",
            "properties": {
              "secretKeyRef": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Secret name"
                  },
                  "key": {
                    "type": "string",
                    "description": "Secret key"
                  },
                  "optional": {
                    "type": "boolean",
                    "description": "Whether the secret key is optional"
                  }
                },
                "required": ["name", "key"],
                "additionalProperties": false
              }
            },
            "required": ["secretKeyRef"],
            "additionalProperties": false
          }
        },
        "required": ["name"],
        "oneOf": [
          { "required": ["value"] },
          { "required": ["valueFrom"] }
        ],
        "additionalProperties": false
      }
    },
    "dataSources": {
      "type": "array",
      "description": "Coordimap Agent data sources rendered directly into coordimap.data_sources",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Data source type"
          },
          "id": {
            "type": "string",
            "description": "Data source id retrieved from the Coordimap UI"
          },
          "config": {
            "type": "array",
            "description": "List of name/value config entries passed through to the agent",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Config key name"
                },
                "value": {
                  "type": ["string", "number", "boolean"],
                  "description": "Config value"
                }
              },
              "required": ["name", "value"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "id", "config"],
        "additionalProperties": false
      }
    }
  },
  "required": ["image", "resources", "apiKey", "endpoint", "dataSources"],
  "additionalProperties": false
}
